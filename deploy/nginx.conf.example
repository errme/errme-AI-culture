# =============================================================================
#  文化站 生产部署 Nginx 配置示例（与 web/tools/serve-dist.mjs 行为等价）
#
#  本机没有 Nginx 时用 `node web/tools/serve-dist.mjs` 验证；上线时用本文件。
#  要点：
#    1) dist/ 由 Nginx 直接托管，history 路由按前缀回退到对应入口 HTML
#    2) 旧的 .html / 旧路径 301 到新的干净 URL
#    3) gzip + 分级缓存（hash 产物一年、HTML 不缓存、老静态 1 天）
#    4) /api /static /index /upload 等反代到 Spring Boot(8081)
# =============================================================================

# ---- 旧地址 -> 干净 URL（301）----
map $uri $legacy_redirect {
    default                              "";
    "/static/auth/login.html"            "/auth/login";
    "/static/auth/login"                 "/auth/login";
    "/static/auth/register.html"         "/auth/register";
    "/static/auth/register"              "/auth/register";
    "/static/auth/forgot.html"           "/auth/forgot";
    "/static/auth/forgot"                "/auth/forgot";
    "/static/auth/admin-login.html"      "/admin/login";
    "/static/auth/admin-login"           "/admin/login";
    "/static/auth/blank.html"            "/auth/login";
    "/index.html"                        "/";
    "/index"                             "/";
    "/login"                             "/auth/login";
    "/signup"                            "/auth/register";
    "/toLogin"                           "/admin/login";
}

server {
    listen       80;
    server_name  culture.example.com;

    root  /var/www/culture/dist;
    index index.html;

    charset utf-8;
    client_max_body_size 220m;          # 与后端 multipart 上限一致（图片/视频上传）

    # ---- 压缩（brotli 可选，需 ngx_brotli 模块，优先级高于 gzip）----
    gzip              on;
    gzip_vary         on;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css text/xml application/javascript application/json
                      application/xml application/rss+xml image/svg+xml;
    # brotli             on;
    # brotli_comp_level 5;
    # brotli_types      text/plain text/css application/javascript application/json image/svg+xml;

    # ---- CSP（内容安全策略）----
    # 现状：后台入口的内联脚本已抽成外部文件（/static/admin/js/native-symbol-guard.js），
    #       因此可以上 CSP —— 但**老后台表格仍在 HTML 字符串里生成 onclick 属性**
    #       （bootstrap-table 的 optFormatter 等），严格 CSP 会拦掉它们。
    # 所以推荐分两步：
    #   第 1 步（现在就开）：只报告不拦截，用浏览器控制台收集违规来源；
    #   第 2 步（把 onclick 改成事件委托后）：换成下面那条强制的 CSP。
    add_header Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; frame-ancestors 'self'" always;
    # 目标状态（需先把行内 onclick 换成 addEventListener / 事件委托，并确认第三方脚本无 eval）：
    # add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" always;

    # ---- 安全响应头 ----
    add_header X-Content-Type-Options    "nosniff"                         always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options           "SAMEORIGIN"                      always;
    # 启用 HTTPS 后再开 HSTS
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ---- 旧地址 301 ----
    if ($legacy_redirect != "") {
        return 301 $legacy_redirect;
    }

    # ---- 业务接口（保持后端自己的缓存策略，不做覆盖）----
    location /api/ {
        proxy_pass         http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # ---- SEO 根路径（必须反代给后端，否则会被 SPA 的 try_files 吃成 front.html）----
    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=600" always;
    }
    # sitemap 分片（规范路径形式；索引默认用 /sitemap.xml?shard=… 查询形式）
    location = /sitemap-static.xml {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=600" always;
    }
    location ~ ^/sitemap-culture-[0-9]+\.xml$ {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=600" always;
    }

    location = /robots.txt {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
    }
    location = /rss.xml {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=600" always;
    }

    # ==========================================================================
    #  运维工具（后台左侧「运维工具」区会列出它们）
    #
    #  ⚠ 这段**必须保留**。不加的话，这些请求会落进最下面的 `location /`，
    #     被 try_files 的前端首页顶替 —— 表现为「后台点『数据库监控 / API 文档』
    #     跳到了前端首页」。预览服 serve-dist.mjs 也修了同一处问题（改成白名单式回退）。
    #
    #  ⚠ 路径必须与后端配置一致（Nginx 无法在运行时读 Spring 配置）：
    #     app.druid.stat.path      默认 /druid/*
    #     app.api-doc.ui-path      默认 /swagger-ui.html（springdoc 会再跳到 /swagger-ui/index.html）
    #     app.api-doc.api-docs-path 默认 /v3/api-docs
    #     改了后端路径，这里要同步改。
    #
    #  ⚠ 生产环境建议同时打开下面的「只允许内网访问」：
    #     API 文档默认是公开的（后端 permitAll），Druid 靠自己的登录 + IP 白名单保护；
    #     在 Nginx 这层再收一道是最省事也最稳妥的做法。
    # ==========================================================================
    location ~ ^/(druid|swagger-ui|v3/api-docs|swagger-resources|webjars) {
        # ---- 只允许本机与内网网段访问（按需启用）----
        # allow 127.0.0.1;
        # allow 10.0.0.0/8;
        # allow 172.16.0.0/12;
        # allow 192.168.0.0/16;
        # deny all;

        proxy_pass         http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        access_log         off;
    }

    # ---- 老设计资源：静态直出（目录结构整理后不再反代后端）----
    #   /index/**        ← web/dist/index/**          （前台设计资源）
    #   /static/admin/** ← web/dist/static/admin/**   （后台设计资源）
    #   /static/auth/**  ← web/dist/static/auth/**    （认证页设计资源）
    # 这些文件没有内容 hash，所以用 1 天缓存 + ETag 协商，而不是一年强缓存。
    location ~ ^/(static|index)/ {
        add_header Cache-Control "public, max-age=86400" always;
        access_log off;
        try_files $uri =404;
    }

    # ---- 后端托管的媒体与上传（仍走 Spring Boot）----
    #   /upload/media/**  富文本正文图片/视频
    #   /showFmImg/**     文化封面（控制器读磁盘）
    #   /showimage/**     用户头像（控制器读磁盘）
    #   /file/**          上传接口
    location ~ ^/(upload|showFmImg|showimage|file)/ {
        proxy_pass         http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_hide_header  Cache-Control;
        add_header         Cache-Control "public, max-age=86400" always;
        access_log         off;
    }

    # ---- 带 hash 的构建产物：一年强缓存 ----
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
        try_files $uri =404;
    }

    # ---- 多入口 SPA：history 路由回退到对应入口 HTML（HTML 一律不缓存）----
    location = /admin/login {
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files /admin-login.html =404;
    }
    location /admin/ {
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri $uri/index.html /admin.html =404;
    }
    location = /admin {
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files /admin.html =404;
    }
    location /auth/ {
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri $uri/index.html /auth.html =404;
    }
    location = /auth {
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files /auth.html =404;
    }
    location / {
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri $uri/index.html /front.html =404;
    }
}
