<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!--
          已从 2.4.4（2021 年，早已 EOL）升级到 3.4.x。
          升级带来的连锁变更见本文件各处的注释与 docs/升级说明。
        -->
        <version>3.4.3</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.culture</groupId>
    <artifactId>culture</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>culture</name>
    <description>culture.com</description>
    <properties>
        <!-- Spring Boot 3.x 要求 JDK 17 起，项目本就按 17 编译/运行 -->
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>
    <dependencies>
        <!-- ==================== Web / 校验 / 缓存 / 邮件 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验（auth 模块 @Valid 使用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Redis（auth 验证码存储 / 60秒限频 / 前台公共列表缓存） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 邮件（auth 验证码邮件发送） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- AOP（操作日志等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- ==================== 安全 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          已删除（升级时清理）：
            · spring-boot-starter-thymeleaf        —— 页面已全部迁到 Vue，没有任何模板
            · thymeleaf-extras-springsecurity5     —— 同上，且 SB3 对应的是 ...6
            · springfox-swagger2 / swagger-ui      —— 2.9.2 不支持 Spring Boot 3，
                                                      且 /swagger-ui 与 /v2/api-docs 是 permitAll 公开的
            · log4j:log4j 1.2.17                   —— 存在 CVE，且与 logback 重复
            · mahout-core / mahout-integration     —— 0.9 依赖 hadoop-core 1.2.1 + javax，
                                                      与 SB3 不可能共存；推荐功能已改为纯 SQL 实现
            · guava（dependencyManagement）        —— 全项目 0 处引用
        -->

        <!-- ==================== JWT ==================== -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== Excel 导出 ==================== -->
        <!--
          只保留 easypoi-base（ExcelExportUtil 在这个包里）。
          easypoi-web 依赖 javax.servlet，在 SB3 下用不到也不需要。
        -->
        <dependency>
            <groupId>cn.afterturn</groupId>
            <artifactId>easypoi-base</artifactId>
            <version>4.5.0</version>
        </dependency>

        <!-- ==================== 数据库 ==================== -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <!-- 3.0.x 才支持 Spring Boot 3（2.x 绑定 Spring 5 / javax） -->
            <version>3.0.4</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- SB3 起坐标由 mysql:mysql-connector-java 改为 com.mysql:mysql-connector-j，版本由父 POM 管理 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          Druid 连接池 + 官方监控页。
          关键：Druid 从 1.2.25 起提供了 **jakarta 变体**
          （包名 com.alibaba.druid.support.jakarta.*），因此 Spring Boot 3 下可以正常挂载
          官方监控 Servlet。1.2.24 及更早只有 javax 版，挂上去会在启动时抛
          NoClassDefFoundError —— 这正是上一轮曾移除该监控页的原因。
          现升级到含 jakarta 变体的 1.2.28，监控页重新接入并纳入后台（见 DruidConfig）。
        -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
            <version>1.2.28</version>
        </dependency>

        <!-- ==================== API 文档（Swagger UI） ==================== -->
        <!--
          springdoc-openapi 2.x 对应 Spring Boot 3.x（3.x 对应 Spring Boot 4）。
          替代原先的 springfox 2.9.2（不支持 SB3，上一轮已删除）。
          开关与访问路径由 application.yml 的 app.api-doc.* 控制，默认仅管理员可见。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.4</version>
        </dependency>

        <!-- ==================== 工具 ==================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <!--
              provided：lombok 只在编译期生成代码，不需要进入运行时 jar。
              原来写的是 optional（只影响传递依赖），仍会被打进 fat jar（约 2MB）。
            -->
            <scope>provided</scope>
        </dependency>

        <!-- ==================== 测试 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--devtools热部署（optional，不会传递给依赖方）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- lombok 是 provided，保险起见再显式排除 -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.*</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.*</include>
                </includes>
            </resource>
            <!--
              原先这里还会把 ../frontend/static（34MB 老设计资源）与 ../frontend/templates
              打进 jar，由 Spring Boot 通过 classpath 静态资源映射对外提供。
              现在这些设计资源已迁到 web/public/ 下，随 `npm run build` 产出到 web/dist，
              由 Nginx 直接托管（URL 完全不变：/index/** 与 /static/{admin,auth}/**），
              因此不再需要打进 jar。
            -->
        </resources>
    </build>

</project>
