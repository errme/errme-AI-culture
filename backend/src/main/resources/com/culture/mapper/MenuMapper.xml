<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN"
 "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">

<!-- 菜单 Mapper（新库 sys_menu / sys_permission / 中间表 sys_user_role、sys_role_permission） -->
<mapper namespace="com.culture.mapper.MenuMapper">

	<resultMap id="BaseResultMap" type="Menu">
		<id column="id" property="id"></id>
		<result column="name" property="name"></result>
		<result column="url" property="url"></result>
		<result column="icon" property="icon"></result>
		<collection property="menus" ofType="Menu">
			<id column="sid" property="id"></id>
			<result column="sname" property="name"></result>
			<result column="surl" property="url"></result>
			<result column="sicon" property="icon"></result>
		</collection>
	</resultMap>

	<!-- 根据登录用户查询菜单（用户->角色->权限->菜单） -->
	<select id="findAll" parameterType="java.lang.Long" resultMap="BaseResultMap">
				select
				pub.id,
				pub.name,
				pub.url,
				pub.icon,
				sub.id sid,
				sub.name sname,
				sub.url surl,
				sub.icon sicon
				from (select m.*
				from sys_user u
				join sys_user_role ur on u.id = ur.user_id
				join sys_role r on ur.role_id = r.id
				join sys_role_permission rp on r.id = rp.role_id
				join sys_permission p on p.id = rp.permission_id
				join sys_menu m on p.menu_id = m.id
				where ur.user_id = #{userid}) sub
				join sys_menu pub on sub.pid = pub.id
	</select>

	<!-- 菜单维护 -->
	<select id="queryAllMenu" resultMap="menuMap">
		select t.id,t.name,t.url,t.pid,t.icon,p.id pid,p.name pname from
			sys_menu t
 		left join sys_permission p on p.menu_id = t.id
	</select>
	<resultMap id="menuMap" type="Menu">
		<id property="id" column="id"></id>
		<result property="name" column="name"></result>
		<result property="url" column="url"></result>
		<result property="pid" column="pid"></result>
		<result property="icon" column="icon"></result>
		<association property="permission" javaType="Permission">
			<id property="id" column="pid"></id>
			<result property="name" column="pname"></result>
		</association>
	</resultMap>

</mapper>
