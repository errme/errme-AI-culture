<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN"
        "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">

<!-- 分类 Mapper（新库 biz_category，name 列映射回 categoryName 属性） -->
<mapper namespace="com.culture.mapper.CategoryMapper">

    <!--所有分类-->
    <select id="queryAll" resultType="Category">
        select id, name as categoryName
        from biz_category
        where deleted = 0
    </select>

    <!--分页-->
    <select id="queryTotal" parameterType="CategoryQuery" resultType="java.lang.Long">
        select count(*)
        from biz_category u
        where u.deleted = 0
    </select>

    <select id="queryData" parameterType="CategoryQuery" resultType="Category">
        select u.id, u.name as categoryName
        from biz_category u
        where u.deleted = 0
        order by u.id desc
            limit #{offset}, #{pageSize}
    </select>

</mapper>
