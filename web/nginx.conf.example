# ============================================================================
# 遇你 · culture —— Nginx 部署配置（前后端分离）
#
# 前端：web/dist（Vue3 构建产物，history 路由，无 .html 后缀）
# 后端：Spring Boot 8081（纯 REST API + 上传媒体 + 原有设计资源）
#
# 用法：
#   npm --prefix web run build
#   nginx -c /path/to/nginx.culture.conf
# ============================================================================

server {
    listen       80;
    server_name  localhost;

    # Vue 构建产物目录（Linux 部署示例：/www/wwwroot/culture/web/dist）
    root  /d/me/AI/culture/web/dist;
    index index.html front.html;   # 预渲染产物优先，其次 SPA 入口

    charset utf-8;
    client_max_body_size 220m;      # 与后端 multipart 上限保持一致

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1k;

    # ---------- 1) 旧 .html / 旧路径 301 到干净 URL ----------
    location = /static/auth/login.html        { return 301 /auth/login; }
    location = /static/auth/login             { return 301 /auth/login; }
    location = /static/auth/register.html     { return 301 /auth/register; }
    location = /static/auth/register          { return 301 /auth/register; }
    location = /static/auth/forgot.html       { return 301 /auth/forgot; }
    location = /static/auth/forgot            { return 301 /auth/forgot; }
    location = /static/auth/admin-login.html  { return 301 /admin/login; }
    location = /static/auth/admin-login       { return 301 /admin/login; }
    location = /login                         { return 301 /auth/login; }
    location = /signup                        { return 301 /auth/register; }
    location = /index.html                    { return 301 /; }
    location = /toLogin                       { return 301 /admin/login; }

    # ---------- 2) 后端接口与后端托管的静态资源 / 媒体 ----------
    location ~ ^/(api|static|index|upload|showFmImg|showimage|file)(/|$) {
        proxy_pass         http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # ---------- 3) 后台管理 SPA ----------
    location /admin {
        # /admin/login 走独立的后台登录入口
        location = /admin/login {
            try_files /admin-login.html =404;
        }
        try_files $uri $uri/ /admin.html;
    }

    # ---------- 4) 认证 SPA（登录/注册/找回密码） ----------
    location ~ ^/(auth|login|signup|forgot) {
        try_files $uri $uri/ /auth.html;
    }

    # ---------- 5) 前台站点：优先预渲染静态页，其次回退 SPA ----------
    location / {
        # /culture/12 → 命中预渲染的 /culture/12/index.html；未预渲染的路由回退 front.html
        try_files $uri $uri/index.html $uri/ /front.html;
    }

    # 构建产物带 hash，可长缓存；入口 HTML 不缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    location ~ ^/(front|auth|admin|admin-login)\.html$ {
        add_header Cache-Control "no-cache";
    }
}
