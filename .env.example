# =============================================================================
#  Docker Compose 环境变量示例：复制成 .env 后按需修改
#    cp .env.example .env && docker compose up -d
# =============================================================================

# 数据库
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=culture_v2
MYSQL_PORT=3306

# Redis
REDIS_PASSWORD=123456
REDIS_PORT=6379

# 后端（容器内 8081 映射到宿主机）
BACKEND_PORT=8081

# 前端静态站点（Nginx）
WEB_PORT=8080

# 站点对外地址：sitemap.xml / robots.txt / rss.xml 与 og:image 会用绝对地址
SITE_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# 可选：前台公共列表（分类 / 标签）的 Redis 读缓存
#   true（默认）—— 写路径主动失效 + TTL 兜底；Redis 不可用时自动降级为直查数据库
#   false        —— 完全关闭缓存（排查「数据看起来没更新」时可先用这个确认）
# ---------------------------------------------------------------------------
APP_CACHE_ENABLED=true
APP_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# 可选：慢 SQL 上报（MyBatis 插件，WARN 日志 + /api/metrics 的 culture_slow_sql_*）
#   APP_SLOW_SQL_THRESHOLD_MS 默认 500，比 Druid 的 1000ms 更严，便于发现退化的查询
# ---------------------------------------------------------------------------
APP_SLOW_SQL_ENABLED=true
APP_SLOW_SQL_THRESHOLD_MS=500

# ---------------------------------------------------------------------------
# 运维工具：Druid 监控页（见 DruidConfig / DevToolsController）
#   DRUID_STAT_ENABLED        true 时注册官方监控页；它会暴露 SQL 统计等敏感信息，
#                             **生产环境建议 false**，排查时临时打开
#   DRUID_STAT_PASSWORD       启用时**必填**且至少 8 位，否则应用启动直接失败
#                             （刻意不设默认弱口令，避免口令跟仓库一起提交）
#   DRUID_STAT_USER           监控页账号（默认 admin）
#   DRUID_STAT_PATH           访问路径（默认 /druid/*）
#   DRUID_STAT_ALLOW          来源 IP 白名单（默认本机 + 内网网段）
#   DRUID_STAT_RESET          是否允许在页面上重置统计（默认 false）
#   DRUID_STAT_URI_MONITOR    是否开启 URI 监控（默认 true，能看到哪些接口慢）
# 访问入口不需要手工记路径：后台左侧「运维工具」区会按当前配置自动列出。
# ---------------------------------------------------------------------------
DRUID_STAT_ENABLED=true
DRUID_STAT_PASSWORD=change-me-at-least-8-chars
DRUID_STAT_USER=admin
DRUID_STAT_PATH=/druid/*
DRUID_STAT_RESET=false
DRUID_STAT_URI_MONITOR=true

# ---------------------------------------------------------------------------
# 运维工具：API 文档（springdoc-openapi / Swagger UI）
#   API_DOC_ENABLED    是否暴露 API 文档；生产建议 false，
#                      或由 Nginx 限制为仅内网可访问（见 deploy/nginx.conf.example）
#   API_DOC_UI_PATH    Swagger UI 路径（默认 /swagger-ui.html）
#   API_DOC_JSON_PATH  OpenAPI JSON 路径（默认 /v3/api-docs）
#   API_DOC_TITLE / API_DOC_DESCRIPTION / API_DOC_VERSION  文档标题等信息
# 文档里已内置「前台Token / 后台Token」两套鉴权方案，可在页面上直接填令牌调试。
# ---------------------------------------------------------------------------
API_DOC_ENABLED=true
API_DOC_UI_PATH=/swagger-ui.html
API_DOC_JSON_PATH=/v3/api-docs
