# =============================================================================
#  遇你 · culture —— Git 忽略规则
#
#  原则：只提交「源码 + 构建配置 + 文档 + 必须入库的静态设计资源」。
#        构建产物、依赖目录、运行时数据、本地密钥一律不入库。
# =============================================================================

# ---------- 构建产物 ----------
backend/target/
web/dist/
*.jar
*.war
*.class

# ---------- 依赖目录 ----------
node_modules/
.pnpm-store/

# ---------- 运行时数据 ----------
#  upload/ 下的内容全部是用户上传的运行时数据，统一不入库：
#    upload/avatar/    头像
#    upload/culture/   文化封面
#    upload/media/     富文本正文图片与视频
#  这些数据由 scripts/backup.sh 备份（DB + 三个上传目录），
#  不通过 git 分发——新环境从备份恢复即可。
upload/
backups/
dump.rdb
*.log
logs/

# ---------- 本地环境与密钥（严禁入库）----------
.env
.env.local
.env.*.local
*.pem
*.key
application-local.yml
application-local.properties

# ---------- 临时/诊断文件 ----------
#  仓库里下划线开头的脚本是开发期临时诊断用的，不应进入版本库
.tmp-seolibs/
web/tools/_*.mjs
web/tools/_shot*.png
*.tmp
*.bak
*~

# 端到端回归套件（e2e-check.mjs）把结果写到「当前工作目录」下的 <调试端口>-e2e.json，
# 属于运行产物，不入库
*-e2e.json

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
